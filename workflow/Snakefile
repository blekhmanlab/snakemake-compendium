from datetime import datetime
import os

configfile: "config/config.yaml"

##############
# These conditions are used to integrate this pipeline to the Compendium Manager software
##############
onstart:
    shell('touch running.txt')
onsuccess:
    shell('rm running.txt')
    shell(f"sbatch --job-name=forward -o logs/{int(round(datetime.now().timestamp()))}.log --chdir={config['cmanager_path']} run_autoforward.slurm")
onerror:
    shell('rm running.txt')
########

def getsamples():
    toget = 'SraAccList.original.txt'
    if os.path.exists('SraAccList.txt'):
        toget = 'SraAccList.txt'
        print("\n\n\nNEW!!!!!!!!--------------------------")
    with open(toget, 'r') as file:
        tosend = file.read().splitlines()
    return tosend

shell.executable("/bin/sh") # sra-tools container doesn't have bash

rule all:
    input:
        'summary.tsv', 'ASV.tsv', 'ASVs.fa', 'ASVs_counts.tsv'

rule sra_prefetch:
    input:
        'SraAccList.original.txt'
    output:
        '{sample}/{sample}.sra'
    threads: 6
    retries: 1
    resources:
        mem_mb=500,
        runtime=180
    shell:
        f"singularity exec --bind /scratch/midway3/rabdill/ {config['resources_path']}sra-tools_3.0.1.sif prefetch --max-size 1t --option-file SraAccList.original.txt"

checkpoint rewrite_acclist:
    input:
        expand('{sample}/{sample}.sra', sample=getsamples())
    output:
        'SraAccList.txt'
    threads: 1
    resources:
        mem_mb=2000,
        runtime=480
    run:
        import os
        new = [sample for sample in os.listdir() if os.path.exists(f'{sample}/{sample}.sra')]
        with open('SraAccList.txt','w') as outfile:
            outfile.write('\n'.join(new))

rule sra_to_fastq:
    input:
        'SraAccList.txt',
        expand('{sample}/{sample}.sra', sample=getsamples())
    output:
        'fastq/{sample}.fastq'
    threads: 4
    resources:
        mem_mb=2000,
        runtime=480
    shell:
        """
        singularity exec --bind /scratch/midway3/rabdill/ {config[resources_path]}sra-tools_3.0.1.sif fasterq-dump --skip-technical --mem 1GB --threads 4 --split-files -O fastq/ {wildcards.sample} &&
            [ ! -f fastq/{wildcards.sample}_1.fastq ] || mv fastq/{wildcards.sample}_1.fastq fastq/{wildcards.sample}.fastq
        """

# This function requests more memory for the "filter" rule based on how many times
# it has already failed.
def get_mem_mb_filter(wildcards, attempt):
    tiers = [16, 24, 48, 64] # in gigabytes
    return tiers[attempt-1] * 1000

rule filter:
    input:
        expand('fastq/{sample}.fastq', sample=getsamples())
    output:
        expand('intermediate/{sample}.R1.filtered.fastq.gz', sample=getsamples()),
        'filtered_out.rds'
    threads: 8
    retries: 0
    resources:
        mem_mb=get_mem_mb_filter,
        runtime=1440
    shell:
        f"singularity exec --bind /scratch/midway3/rabdill/ /project/blekhman/rabdill/containers/dada2_1260a.sif Rscript scripts/filter.R"

def get_mem_mb_errormodel(wildcards, attempt):
    tiers = [16, 32, 64, 96]
    return tiers[attempt-1] * 1000

# NOTE: We don't calculate the error models in parallel because it's needlessly
# complicated to tell Snakemake to conditionally require the reverse model
rule errormodel:
    input:
        expand('intermediate/{sample}.R1.filtered.fastq.gz', sample=getsamples()),
        'filtered_out.rds'
    output:
        'err_forward_reads.rds',
        'forward_error_model.pdf'
    threads: 8
    retries: 0
    resources:
        mem_mb=get_mem_mb_errormodel,
        runtime=1440
    shell:
        f"singularity exec --bind /scratch/midway3/rabdill/ {config['resources_path']}dada2_1260a.sif Rscript scripts/error_models.R"

def get_mem_mb_dada(wildcards, attempt):
    if len(samples) < 50:
        tiers = [16, 32, 48, 56]
    elif len(samples) < 150:
        tiers = [32, 48, 56, 72]
    elif len(samples) < 400:
        tiers = [48, 64, 96, 96]
    else:
        tiers = [64, 80, 96, 118]
    return(tiers[attempt-1] * 1000)

def get_runtime_dada(wildcards, attempt):
    tiers = [48, 64, 96, 96] # hours
    return(tiers[attempt-1] * 60)

rule make_asv_table:
    input:
        expand('intermediate/{sample}.R1.filtered.fastq.gz', sample=getsamples()),
        'err_forward_reads.rds'
    output:
        'summary.tsv', 'ASV.tsv', 'ASVs.fa', 'ASVs_counts.tsv'
    threads: 8
    retries: 0
    resources:
        mem_mb=get_mem_mb_dada,
        runtime=get_runtime_dada
    shell:
        f"singularity exec --bind /scratch/midway3/rabdill/ {config['resources_path']}dada2_1260a.sif Rscript scripts/generate_asvs.R"
